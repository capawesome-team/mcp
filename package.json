{
  "name": "@capawesome/mcp",
  "version": "0.0.1",
  "description": "The official MCP server for Capawesome documentation and Capawesome Cloud.",
  "mcpName": "io.capawesome/mcp",
  "type": "module",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "start": "npm run build && node ./dist/index.js",
    "test": "npm run build && vitest run",
    "test:watch": "vitest --watch",
    "lint": "npm run prettier -- --check",
    "fmt": "npm run prettier -- --write",
    "prettier": "prettier \"**/*.{json,md,ts}\"",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "capawesome-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "capacitor",
    "capawesome",
    "capawesome-cloud",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Robin Genz <mail@robingenz.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capawesome-team/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/capawesome-team/mcp/issues"
  },
  "homepage": "https://capawesome.io/",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/capawesome-team/"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/capawesome"
    }
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@types/node": "24.10.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.3.3",
    "prettier-plugin-organize-imports": "4.0.0",
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "lint-staged": {
    "**/*.{json,md,ts}": "prettier --write"
  }
}
