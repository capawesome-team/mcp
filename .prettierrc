{
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "overrides": [
    {
      "files": "*.json",
      "options": {
        "printWidth": 1
      }
    }
  ],
  "plugins": [
    "prettier-plugin-organize-imports"
  ],
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all"
}
